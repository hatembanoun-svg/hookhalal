# ---------- LLM (hook generation) ----------
# Free key from https://console.groq.com  (users can also paste their own in the UI)
GROQ_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback: local Ollama (OpenAI-compatible endpoint). In Docker use http://host.docker.internal:11434/v1
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ---------- Video generation ----------
# Optional server-side key. Leave empty to force BYOK (users paste their own fal.ai key in the UI).
# Get one at https://fal.ai/dashboard/keys  (new accounts get free credits)
FAL_KEY=
# Verify the exact endpoint IDs in the fal.ai model gallery; override here if they differ.
FAL_MODEL=fal-ai/wan-t2v
# Alternative: FAL_MODEL=fal-ai/veo3/fast  (Veo min duration is 4s)
FAL_RESOLUTION=480p
FAL_RESOLUTION_PREMIUM=720p

# Local fallback via ComfyUI (Wan 2.1 1.3B). See README.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/wan21-1.3b-t2v.api.json

# ---------- Storage ----------
DATA_DIR=/tmp/hookhalal

# ---------- Monetization (LemonSqueezy) ----------
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_BASIC=
LS_VARIANT_PRO=
LS_VARIANT_PREMIUM=
NEXT_PUBLIC_LS_CHECKOUT_BASIC=
NEXT_PUBLIC_LS_CHECKOUT_PRO=
NEXT_PUBLIC_LS_CHECKOUT_PREMIUM=
NEXT_PUBLIC_LIBRARY_BADGE=
